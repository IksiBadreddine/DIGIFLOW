# =====================================
# Embeddings
# =====================================

# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-m3

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# =====================================
# Vector Database
# =====================================

VECTOR_DB=chroma

# OCR
OCR_LANGUAGE=fra
OCR_ENGINE=easyocr  # ou tesseract

# Ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=120
USE_OCR=true
PAGES_TO_OCR=-1  # -1 = toutes les pages

# Standards
EXTRACT_CROSS_REFERENCES=true